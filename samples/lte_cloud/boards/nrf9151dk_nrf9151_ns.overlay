/*
 * Flash layout without MCUboot (NCS v3.4 uses devicetree partitions, TF-M
 * reads them from slot0_s_partition / slot0_ns_partition):
 *
 * 0x0000_0000 TF-M secure image      (64 KB, TF-M minimal profile ~32 KB)
 * 0x0001_0000 Non-secure application (896 KB)
 * 0x000f_0000 TF-M PS / ITS / OTP    (32 KB, unchanged)
 * 0x000f_8000 Non-secure storage     (32 KB, unchanged)
 *
 * The secure/non-secure boundary must stay aligned to the 32 KB SPU region.
 * For DFU with MCUboot use the default board layout instead.
 */

/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;

&flash0 {
	partitions {
		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00000000 0xf0000>;
			ranges = <0x0 0x0 0xf0000>;
			#address-cells = <1>;
			#size-cells = <1>;

			slot0_s_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "image-0-secure";
				reg = <0x00000000 0x10000>;
			};

			slot0_ns_partition: partition@10000 {
				compatible = "zephyr,mapped-partition";
				label = "image-0-nonsecure";
				reg = <0x00010000 0xe0000>;
			};
		};
	};
};
