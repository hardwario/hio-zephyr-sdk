config HIO_CONFIG
	bool "HIO_CONFIG"
	select HIO_UTIL
	select HIO_SYS
	select CBPRINTF_FP_SUPPORT
	select EVENTS
	select FLASH
	select FLASH_MAP
	select NVS
	select REBOOT
	select SETTINGS
	select SETTINGS_RUNTIME

if HIO_CONFIG


config HIO_CONFIG_INIT_PRIORITY
	int "Initialization priority"
	default 0

config HIO_CONFIG_SETTINGS_PFX
	string "HIO_CONFIG_SETTINGS_PFX"
	default ""

config HIO_CONFIG_SETTINGS_KEY_MAX
	int "Maximum length of settings key (module/item)"
	default 96

config HIO_CONFIG_VALUE_MAX_SIZE
	int "Maximum size of a config item value in bytes"
	default 128
	help
	  Size of the stack buffer used to read a saved item value back from
	  the storage (config diff, config hash and the config upload to the
	  cloud with unsaved changes). Items larger than this make those
	  operations fail with -ENOSPC.

config HIO_CONFIG_SHELL
	bool "HIO_CONFIG_SHELL"
	default y if SHELL

config HIO_CONFIG_ATCI
	bool "HIO_CONFIG_ATCI"
	default y if HIO_ATCI
	select HIO_TOK

config HIO_CONFIG_ATCI_CMD_AUTH_FLAGS
	int "HIO_CONFIG ATCI commands authentication flags"
	depends on HIO_CONFIG_ATCI
	default 1 if HIO_ATCI_LOGIN
	default 0
	help
	  Authentication flags applied to all HIO_CONFIG ATCI commands
	  (&F, &W, $CONFIG). Used to restrict access via the ATCI auth
	  check callback.

module = HIO_CONFIG
module-str = HIO Configuration Subsystem
source "subsys/logging/Kconfig.template.log_config"

endif # HIO_CONFIG
